# Copy to .env, generate three different passwords, and chmod 600 .env.
# Use hexadecimal values (openssl rand -hex 32) so DSN URL escaping is unnecessary.
ASTER_ARCHIVE_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_BOOTSTRAP_PASSWORD
ASTER_ARCHIVE_INGEST_PASSWORD=REPLACE_WITH_RANDOM_HEX_INGEST_PASSWORD
ASTER_ARCHIVE_READ_PASSWORD=REPLACE_WITH_RANDOM_HEX_READER_PASSWORD

# Keep these identifiers stable across repeated exports from this account/workspace.
ASTER_ARCHIVE_OWNER=owner-personal
ASTER_ARCHIVE_SOURCE=chatgpt-personal
ASTER_ARCHIVE_INBOX=/srv/aster-archive/inbox
# Keep 10 GiB free on the archive filesystem; bytes, positive integer (max 1 PiB).
ASTER_ARCHIVE_MIN_FREE_BYTES=10737418240

# Additive migrations and read-side enrichment. Prepare pinned public models
# before starting the three enrichment workers; no reader downloads models.
ASTER_ARCHIVE_ENABLE_ENRICHMENT=1
ASTER_ARCHIVE_EMBEDDING_MODEL_DIR=/var/lib/aster-archive-models/e5-small
ASTER_ARCHIVE_EMBEDDING_BATCH_SIZE=4
ASTER_ARCHIVE_EMBEDDING_THREADS=2
ASTER_ARCHIVE_EMBEDDING_CPUS=2.0
ASTER_ARCHIVE_EMBEDDING_MEMORY_LIMIT=2g
# Default Cognee runs only a five-passage qualification sample. Set 1 explicitly
# after reviewing its cited results; >=5 completed sample passages are required.
# Exhausted jobs remain visibly failed without blocking other eligible passages.
ASTER_ARCHIVE_COGNEE_ENABLE_BACKLOG=0
# After qualifying a lossless archive/restore, compress completed revision stores.
# Receipts and PostgreSQL summaries remain directly readable. See archive-knowledge.md.
ASTER_ARCHIVE_COGNEE_COMPACT_COMPLETED=0

# Persistent Cognee resources. CPU is the default; successful productive batches
# continue immediately, while idle and failing batches retain the poll interval.
ASTER_ARCHIVE_COGNEE_BATCH_SIZE=2
ASTER_ARCHIVE_COGNEE_WORK_PAUSE_SECONDS=0
ASTER_ARCHIVE_COGNEE_CPU_THREADS=2
# Chunks evaluated together within one passage, distinct from passage batch size.
# Keep the CPU default of one; qualify an explicit larger value for CUDA (1..16).
ASTER_ARCHIVE_COGNEE_INFERENCE_BATCH_SIZE=1
ASTER_ARCHIVE_COGNEE_CPUS=2.0
ASTER_ARCHIVE_COGNEE_MEMORY_LIMIT=6g
ASTER_ARCHIVE_COGNEE_MEMORY_BYTES=6442450944
ASTER_ARCHIVE_COGNEE_TIMEOUT_SECONDS=900
ASTER_ARCHIVE_COGNEE_DEVICE=cpu
ASTER_ARCHIVE_COGNEE_GPU_MEMORY_FRACTION=0.9
ASTER_ARCHIVE_COGNEE_IMAGE=aster-archive-cognee:local
ASTER_ARCHIVE_COGNEE_DOCKERFILE=deploy/archive/cognee/Dockerfile
ASTER_ARCHIVE_COGNEE_CPU_IMAGE=aster-archive-cognee:local
ASTER_ARCHIVE_COGNEE_ACCELERATION_FILE=cognee/acceleration-cpu.yaml

# For a qualified NVIDIA CDI host, change these four values together. Use a
# distinct CUDA image tag so the existing CPU image remains available for rollback.
# ASTER_ARCHIVE_COGNEE_DEVICE=cuda
# ASTER_ARCHIVE_COGNEE_IMAGE=aster-archive-cognee:cuda
# ASTER_ARCHIVE_COGNEE_DOCKERFILE=deploy/archive/cognee/Dockerfile.cuda
# ASTER_ARCHIVE_COGNEE_ACCELERATION_FILE=cognee/acceleration-cuda.yaml

# Dedicated verified HTTPS origin; do not reuse the machine-execution service origin.
ASTER_ARCHIVE_PUBLIC_ORIGIN=https://archive.example.invalid
ASTER_ARCHIVE_HTTP_PORT=8770

# Qualify this unused subnet and verify the observed reverse-proxy peer on the host.
ASTER_ARCHIVE_NETWORK_SUBNET=172.30.77.0/24
ASTER_ARCHIVE_NETWORK_GATEWAY=172.30.77.1
ASTER_ARCHIVE_TRUSTED_PROXY_HOST=172.30.77.1

# Verify this additional unused subnet. It has no external route. MCP stays on
# the archive bridge above so its verified immediate proxy peer is unchanged.
ASTER_ARCHIVE_ENRICHMENT_NETWORK_SUBNET=172.30.79.0/24
ASTER_ARCHIVE_ENRICHMENT_NETWORK_GATEWAY=172.30.79.1
