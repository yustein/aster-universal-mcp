# Copy to .env, generate three different passwords, and chmod 600 .env.
# Use hexadecimal values (openssl rand -hex 32) so DSN URL escaping is unnecessary.
ASTER_ARCHIVE_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_BOOTSTRAP_PASSWORD
ASTER_ARCHIVE_INGEST_PASSWORD=REPLACE_WITH_RANDOM_HEX_INGEST_PASSWORD
ASTER_ARCHIVE_READ_PASSWORD=REPLACE_WITH_RANDOM_HEX_READER_PASSWORD

# Keep these identifiers stable across repeated exports from this account/workspace.
ASTER_ARCHIVE_OWNER=owner-personal
ASTER_ARCHIVE_SOURCE=chatgpt-personal
ASTER_ARCHIVE_INBOX=/srv/aster-archive/inbox
# Keep 10 GiB free on the archive filesystem; bytes, positive integer (max 1 PiB).
ASTER_ARCHIVE_MIN_FREE_BYTES=10737418240

# Dedicated verified HTTPS origin; do not reuse the machine-execution service origin.
ASTER_ARCHIVE_PUBLIC_ORIGIN=https://archive.example.invalid
ASTER_ARCHIVE_HTTP_PORT=8770

# Qualify this unused subnet and verify the observed reverse-proxy peer on the host.
ASTER_ARCHIVE_NETWORK_SUBNET=172.30.77.0/24
ASTER_ARCHIVE_NETWORK_GATEWAY=172.30.77.1
ASTER_ARCHIVE_TRUSTED_PROXY_HOST=172.30.77.1
