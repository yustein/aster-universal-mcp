# Root-owned mode 0600: /etc/aster-archive/enrichment-status.env
# The probe uses the existing reader container's credentials internally.
# Do not copy database passwords into this file.
ASTER_ARCHIVE_REPO=/opt/aster-conversation-archive
ASTER_ARCHIVE_OWNER=owner-personal
ASTER_ARCHIVE_SOURCE=chatgpt-personal
ASTER_ARCHIVE_READER_CONTAINER=aster-archive-mcp-1
